# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DB_ENCRYPTION_SECRET: REQUIRED. Used to derive the AES-256-GCM key that
# encrypts private journal entries and peer messages at rest. There is
# NO fallback — the server refuses to start without this set, on purpose.
# Generate one with: openssl rand -hex 32
# Changing this after data exists makes existing encrypted entries
# undecryptable, so back it up somewhere safe (e.g. your password manager),
# separate from this repo.
DB_ENCRYPTION_SECRET="CHANGE_ME_USE_openssl_rand_-hex_32"

# MODERATOR_INVITE_CODE: Optional. If set, a person who enters this exact
# code during registration is granted the moderator role. Leave unset to
# disable self-service moderator signup entirely (recommended once you
# have your real moderator team set up).
MODERATOR_INVITE_CODE=""

# NODE_ENV: "production" enables secure cookies (HTTPS-only) and serves
# the built dist/ bundle instead of the Vite dev server.
NODE_ENV="production"

# PORT: internal port the Node server listens on. 3000 matches the port
# already wired up for Nginx Proxy Manager routing.
PORT="3000"
